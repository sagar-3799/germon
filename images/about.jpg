<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="aboutGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2B2E83"/>
      <stop offset="100%" stop-color="#18A8E8"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#aboutGrad)" rx="16"/>
  <rect x="40" y="40" width="720" height="520" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="12"/>
  <!-- Server / Data Center Graphic -->
  <g transform="translate(250, 150)">
    <rect x="0" y="0" width="300" height="70" rx="8" fill="#FFFFFF" opacity="0.95"/>
    <circle cx="30" cy="35" r="8" fill="#F5000D"/>
    <circle cx="55" cy="35" r="8" fill="#18A8E8"/>
    <line x1="90" y1="35" x2="270" y2="35" stroke="#2B2E83" stroke-width="4" stroke-linecap="round"/>
    
    <rect x="0" y="90" width="300" height="70" rx="8" fill="#FFFFFF" opacity="0.95"/>
    <circle cx="30" cy="125" r="8" fill="#F5000D"/>
    <circle cx="55" cy="125" r="8" fill="#18A8E8"/>
    <line x1="90" y1="125" x2="270" y2="125" stroke="#2B2E83" stroke-width="4" stroke-linecap="round"/>

    <rect x="0" y="180" width="300" height="70" rx="8" fill="#FFFFFF" opacity="0.95"/>
    <circle cx="30" cy="215" r="8" fill="#F5000D"/>
    <circle cx="55" cy="215" r="8" fill="#18A8E8"/>
    <line x1="90" y1="215" x2="270" y2="215" stroke="#2B2E83" stroke-width="4" stroke-linecap="round"/>
  </g>
  <text x="400" y="480" font-family="'Montserrat', sans-serif" font-weight="800" font-size="28" fill="#FFFFFF" text-anchor="middle">Germon IT Headquarters</text>
  <text x="400" y="520" font-family="'Poppins', sans-serif" font-size="18" fill="rgba(255,255,255,0.85)" text-anchor="middle">Narayangarh, Chitwan, Nepal</text>
</svg>
